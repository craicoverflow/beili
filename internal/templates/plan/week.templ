package plan

import (
	"fmt"
	"time"
	"github.com/craicoverflow/beili/internal/models"
)

// WeekData bundles everything the meal plan template needs.
//
// The same payload feeds two layouts:
//   - Desktop (md+): a 7-day Mon–Sun grid anchored at WeekStart.
//   - Mobile: a rolling 4-day list starting at MobileStart (defaults to today).
type WeekData struct {
	WeekStart   time.Time
	MobileStart time.Time
	Entries     map[string]map[models.MealType]*models.MealPlanEntry // date → mealType → entry
	BasePath    string
}

// ISOWeek returns the ISO week label for the desktop week, e.g. "2025-W15".
func (w WeekData) ISOWeek() string {
	year, week := w.WeekStart.ISOWeek()
	return fmt.Sprintf("%d-W%02d", year, week)
}

// PrevWeekStart / NextWeekStart return the ?start= value for the desktop
// prev/next-week buttons (anchored to a Monday so the grid stays aligned).
func (w WeekData) PrevWeekStart() string {
	return w.WeekStart.AddDate(0, 0, -7).Format("2006-01-02")
}

func (w WeekData) NextWeekStart() string {
	return w.WeekStart.AddDate(0, 0, 7).Format("2006-01-02")
}

// PrevMobileStart / NextMobileStart return the ?start= value for the mobile
// rolling-window prev/next buttons (±4 days from the current anchor).
func (w WeekData) PrevMobileStart() string {
	return w.MobileStart.AddDate(0, 0, -4).Format("2006-01-02")
}

func (w WeekData) NextMobileStart() string {
	return w.MobileStart.AddDate(0, 0, 4).Format("2006-01-02")
}

// Days returns the 7 dates (Mon–Sun) for the desktop week.
func (w WeekData) Days() []time.Time {
	days := make([]time.Time, 7)
	for i := range days {
		days[i] = w.WeekStart.AddDate(0, 0, i)
	}
	return days
}

// MobileDays returns the 4 dates of the mobile rolling window.
func (w WeekData) MobileDays() []time.Time {
	days := make([]time.Time, 4)
	for i := range days {
		days[i] = w.MobileStart.AddDate(0, 0, i)
	}
	return days
}

// MobileRangeLabel formats the mobile window as e.g. "Mon 4 – Thu 7 May".
func (w WeekData) MobileRangeLabel() string {
	last := w.MobileStart.AddDate(0, 0, 3)
	if w.MobileStart.Month() == last.Month() {
		return fmt.Sprintf("%s – %s", w.MobileStart.Format("Mon 2"), last.Format("Mon 2 Jan"))
	}
	return fmt.Sprintf("%s – %s", w.MobileStart.Format("Mon 2 Jan"), last.Format("Mon 2 Jan"))
}

// MealRows returns the meal types to show as rows, in display order.
func MealRows() []models.MealType {
	return []models.MealType{
		models.MealTypeBreakfast,
		models.MealTypeLunch,
		models.MealTypeDinner,
		models.MealTypeSnack,
	}
}

templ Week(data WeekData) {
	<div id="calendar" class="min-w-0" data-base-path={ data.BasePath }>
		@desktopView(data)
		@mobileView(data)
	</div>

	<!-- Undo toast for meal removal — reassigned on every week render, harmless
	     since it's just a plain function reference, not an accumulating listener. -->
	<script>
		window.beiliMealRemoved = function(btn) {
			var payload = {
				mealID:   btn.dataset.mealId,
				date:     btn.dataset.date,
				mealType: btn.dataset.mealType,
				servings: btn.dataset.servings || '',
				leftover: btn.dataset.leftover === 'true',
			};
			var container = document.getElementById('notifications');
			if (!container) return;

			var toast = document.createElement('div');
			toast.className = 'bg-surface-2 border border-ui-border text-ui-text px-4 py-3 rounded-lg text-sm shadow-lg flex items-center gap-3';
			var label = document.createElement('span');
			label.textContent = 'Removed from plan';
			var undoBtn = document.createElement('button');
			undoBtn.textContent = 'Undo';
			undoBtn.className = 'text-accent font-medium hover:underline shrink-0';
			toast.appendChild(label);
			toast.appendChild(undoBtn);
			container.appendChild(toast);

			var timer = setTimeout(function() { toast.remove(); }, 5000);
			undoBtn.addEventListener('click', function() {
				clearTimeout(timer);
				toast.remove();
				var vals = { date: payload.date, meal_type: payload.mealType, meal_id: payload.mealID };
				if (payload.servings) vals.servings = payload.servings;
				if (payload.leftover) vals.is_leftover = 'true';
				var basePath = document.getElementById('calendar').dataset.basePath || '';
				htmx.ajax('POST', basePath + '/plan', {
					target: '#cell-' + payload.date + '-' + payload.mealType,
					swap: 'outerHTML',
					values: vals,
				});
			});
		};

		// htmx:afterRequest turned out not to fire reliably for this button on
		// this htmx build (neither via hx-on attributes nor via addEventListener
		// attached through htmx.onLoad — root cause not fully pinned down, likely
		// an interaction with the outerHTML swap replacing the button's own
		// ancestor). A plain 'click' event, by contrast, reliably bubbles to
		// document, so show the undo toast optimistically on click rather than
		// waiting for confirmation — removal is a fast, simple DELETE that isn't
		// expected to fail in normal use. Bound once (guarded) since this script
		// re-runs on every week partial render.
		if (!window.__beiliRemoveListenerBound) {
			window.__beiliRemoveListenerBound = true;
			document.addEventListener('click', function(e) {
				var btn = e.target.closest && e.target.closest('.remove-btn');
				if (btn) {
					window.beiliMealRemoved(btn);
				}
			});
		}
	</script>
}

// --- Desktop: ISO week grid (Mon–Sun) ---

templ desktopView(data WeekData) {
	<div class="hidden md:block">
		<!-- Header: week nav + title -->
		<div class="flex items-center justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold text-ui-text">Meal Plan</h1>
				<p class="text-ui-muted text-sm mt-0.5">
					{ data.WeekStart.Format("2 Jan") } – { data.WeekStart.AddDate(0, 0, 6).Format("2 Jan 2006") }
				</p>
			</div>
			<div class="flex items-center gap-2">
				@navButton(data.BasePath+"/plan?start="+data.PrevWeekStart(), "Previous week", iconChevronLeft())
				<button
					class="px-3 py-1.5 text-xs rounded-lg bg-surface-2 border border-ui-border text-ui-muted hover:text-ui-text hover:border-ui-border-medium transition-colors"
					hx-get={ data.BasePath + "/plan" }
					hx-target="#calendar"
					hx-swap="outerHTML"
					hx-push-url="true"
				>Today</button>
				@navButton(data.BasePath+"/plan?start="+data.NextWeekStart(), "Next week", iconChevronRight())
			</div>
		</div>

		<!-- Calendar grid -->
		<div class="overflow-x-auto">
			<div class="min-w-[700px]">
				<!-- Day headers -->
				<div class="grid grid-cols-[80px_repeat(7,1fr)] gap-1 mb-1">
					<div></div>
					for _, day := range data.Days() {
						<div class={
							"text-center py-2 rounded-lg text-xs font-medium",
							templ.KV("bg-accent/10 text-accent", isToday(day)),
							templ.KV("text-ui-muted", !isToday(day)),
						}>
							<div class="font-semibold">{ day.Format("Mon") }</div>
							<div class={
								"text-lg font-bold mt-0.5",
								templ.KV("text-accent", isToday(day)),
								templ.KV("text-ui-subtext", !isToday(day)),
							}>{ day.Format("2") }</div>
						</div>
					}
				</div>

				<!-- Meal type rows -->
				for _, mt := range MealRows() {
					<div class="grid grid-cols-[80px_repeat(7,1fr)] gap-1 mb-1">
						<div class="flex items-center justify-end pr-2 py-2">
							<span class="text-xs text-ui-dim font-medium">{ mt.Label() }</span>
						</div>
						for _, day := range data.Days() {
							@DayCell(DayCellData{
								Date:     day.Format("2006-01-02"),
								MealType: mt,
								Entry:    data.Entries[day.Format("2006-01-02")][mt],
								BasePath: data.BasePath,
							})
						}
					</div>
				}
			</div>
		</div>
	</div>
}

// --- Mobile: rolling 4-day list (Google Calendar 4-day-view style) ---

templ mobileView(data WeekData) {
	<div class="md:hidden">
		<!-- Header -->
		<div class="flex items-center justify-between mb-4">
			<div class="min-w-0">
				<h1 class="text-xl font-bold text-ui-text">Meal Plan</h1>
				<p class="text-ui-muted text-xs mt-0.5 truncate">{ data.MobileRangeLabel() }</p>
			</div>
			<div class="flex items-center gap-1.5 shrink-0">
				@navButton(data.BasePath+"/plan?start="+data.PrevMobileStart(), "Previous days", iconChevronLeft())
				<button
					class="px-2.5 py-1.5 text-xs rounded-lg bg-surface-2 border border-ui-border text-ui-muted hover:text-ui-text hover:border-ui-border-medium transition-colors"
					hx-get={ data.BasePath + "/plan" }
					hx-target="#calendar"
					hx-swap="outerHTML"
					hx-push-url="true"
				>Today</button>
				@navButton(data.BasePath+"/plan?start="+data.NextMobileStart(), "Next days", iconChevronRight())
			</div>
		</div>

		<!-- Day cards -->
		<div class="space-y-3">
			for _, day := range data.MobileDays() {
				@mobileDayCard(data, day)
			}
		</div>
	</div>
}

templ mobileDayCard(data WeekData, day time.Time) {
	<section class={
		"rounded-xl border bg-surface-2 overflow-hidden",
		templ.KV("border-accent/40 ring-1 ring-accent/20", isToday(day)),
		templ.KV("border-ui-border", !isToday(day)),
	}>
		<!-- Day header -->
		<header class={
			"flex items-baseline gap-2 px-3 py-2 border-b",
			templ.KV("bg-accent/10 border-accent/30", isToday(day)),
			templ.KV("border-ui-border-strong", !isToday(day)),
		}>
			<span class={
				"text-xs font-semibold uppercase tracking-wide",
				templ.KV("text-accent", isToday(day)),
				templ.KV("text-ui-muted", !isToday(day)),
			}>
				if isToday(day) {
					Today
				} else {
					{ day.Format("Mon") }
				}
			</span>
			<span class={
				"text-sm",
				templ.KV("text-accent font-semibold", isToday(day)),
				templ.KV("text-ui-subtext", !isToday(day)),
			}>{ day.Format("2 Jan") }</span>
		</header>

		<!-- Meal rows for this day -->
		<div class="divide-y divide-ui-border-strong">
			for _, mt := range MealRows() {
				<div class="flex items-stretch gap-3 px-3 py-2">
					<div class="w-16 shrink-0 flex items-center">
						<span class="text-[11px] uppercase tracking-wide text-ui-dim font-medium">{ mt.Label() }</span>
					</div>
					<div class="flex-1 min-w-0">
						@DayCell(DayCellData{
							Date:     day.Format("2006-01-02"),
							MealType: mt,
							Entry:    data.Entries[day.Format("2006-01-02")][mt],
							BasePath: data.BasePath,
						})
					</div>
				</div>
			}
		</div>
	</section>
}

// --- Shared bits ---

templ navButton(href string, label string, icon templ.Component) {
	<button
		class="p-2 rounded-lg bg-surface-2 border border-ui-border text-ui-muted hover:text-ui-text hover:border-ui-border-medium transition-colors"
		hx-get={ href }
		hx-target="#calendar"
		hx-swap="outerHTML"
		hx-push-url="true"
		aria-label={ label }
	>
		@icon
	</button>
}

templ iconChevronLeft() {
	<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
		<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
	</svg>
}

templ iconChevronRight() {
	<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
		<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
	</svg>
}

func isToday(t time.Time) bool {
	now := time.Now()
	return t.Year() == now.Year() && t.Month() == now.Month() && t.Day() == now.Day()
}

package plan

import (
	"fmt"
	"time"

	"github.com/craicoverflow/beili/internal/models"
)

// ShoppingGroup is one meal and the day/slot labels it appears in for the week.
type ShoppingGroup struct {
	Meal  *models.Meal
	Slots []string // e.g. ["Mon · Dinner", "Wed · Lunch"]
	// Ingredients is meal.Ingredients scaled to Servings when it differs from
	// the meal's base servings (see internal/scaling — deterministic, never AI).
	Ingredients []string
	// Servings is the serving count Ingredients is scaled to. Zero means
	// unscaled (matches the meal's base) — the header hides the "(N servings)" hint.
	Servings int
}

// ShoppingListData bundles everything the shopping list template needs.
type ShoppingListData struct {
	WeekStart time.Time
	Groups    []ShoppingGroup
	Extras    []models.ShoppingExtra
	BasePath  string
	// OurGroceriesEnabled toggles the Planned/List view switcher; when false the
	// live OurGroceries mirror isn't available so the switcher is hidden.
	OurGroceriesEnabled bool
}

func (d ShoppingListData) isoWeek() string {
	year, week := d.WeekStart.ISOWeek()
	return fmt.Sprintf("%d-W%02d", year, week)
}

func (d ShoppingListData) prevWeek() string {
	prev := d.WeekStart.AddDate(0, 0, -7)
	year, week := prev.ISOWeek()
	return fmt.Sprintf("%d-W%02d", year, week)
}

func (d ShoppingListData) nextWeek() string {
	next := d.WeekStart.AddDate(0, 0, 7)
	year, week := next.ISOWeek()
	return fmt.Sprintf("%d-W%02d", year, week)
}

func (d ShoppingListData) weekLabel() string {
	end := d.WeekStart.AddDate(0, 0, 6)
	if d.WeekStart.Month() == end.Month() {
		return fmt.Sprintf("%s %d–%d", d.WeekStart.Format("Jan"), d.WeekStart.Day(), end.Day())
	}
	return fmt.Sprintf("%s %d – %s %d", d.WeekStart.Format("Jan"), d.WeekStart.Day(), end.Format("Jan"), end.Day())
}

func (d ShoppingListData) totalIngredients() int {
	n := 0
	for _, g := range d.Groups {
		n += len(g.Ingredients)
	}
	return n + len(d.Extras)
}

// itemKey returns a stable localStorage key for a single ingredient checkbox.
func itemKey(weekISO, mealID, ingredient string) string {
	return weekISO + "|" + mealID + "|" + ingredient
}

templ ShoppingList(d ShoppingListData) {
	<style>
		@media print {
			nav, #global-loader, .no-print { display: none !important; }
			body, main, #main-content { background: white !important; color: black !important; }
			.bg-surface-2 { background: #f5f5f5 !important; border-color: #ddd !important; }
			.text-ui-text, .text-ui-text, .text-ui-subtext { color: #111 !important; }
			.text-ui-muted, .text-ui-muted { color: #555 !important; }
			.text-ui-dim { color: #888 !important; }
			a { color: #111 !important; text-decoration: none !important; }
			.border-ui-border-strong { border-color: #ddd !important; }
		}
	</style>
	<div id="shopping-list" class="space-y-6">
		<!-- Page header -->
		<div class="flex items-center justify-between flex-wrap gap-4">
			<div>
				<h1 class="text-2xl font-bold text-ui-text">Shopping List</h1>
				<p class="text-sm text-ui-muted mt-0.5">{ d.weekLabel() } · { d.isoWeek() }</p>
			</div>

			<!-- Week navigation -->
			<div class="flex items-center gap-2 no-print">
				if d.OurGroceriesEnabled {
					@shoppingViewToggle(d.BasePath, "planned", d.isoWeek())
				}
				<a
					href={ templ.SafeURL(d.BasePath + "/shopping?week=" + d.prevWeek()) }
					class="p-2 rounded-lg bg-surface-2 border border-ui-border text-ui-muted hover:text-ui-text hover:border-ui-border-medium transition-colors"
					aria-label="Previous week"
				>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
					</svg>
				</a>
				<a
					href={ templ.SafeURL(d.BasePath + "/shopping") }
					class="px-3 py-1.5 text-sm rounded-lg bg-surface-2 border border-ui-border text-ui-subtext hover:text-ui-text hover:border-ui-border-medium transition-colors"
				>
					This week
				</a>
				<a
					href={ templ.SafeURL(d.BasePath + "/shopping?week=" + d.nextWeek()) }
					class="p-2 rounded-lg bg-surface-2 border border-ui-border text-ui-muted hover:text-ui-text hover:border-ui-border-medium transition-colors"
					aria-label="Next week"
				>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
					</svg>
				</a>

				<a
					href={ templ.SafeURL(d.BasePath + "/plan?week=" + d.isoWeek()) }
					class="ml-2 px-3 py-1.5 text-sm rounded-lg bg-surface-2 border border-ui-border text-ui-subtext hover:text-ui-text hover:border-ui-border-medium transition-colors flex items-center gap-1.5"
				>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
					</svg>
					View plan
				</a>
				<button
					onclick="window.print()"
					class="ml-2 px-3 py-1.5 text-sm rounded-lg bg-surface-2 border border-ui-border text-ui-subtext hover:text-ui-text hover:border-ui-border-medium transition-colors flex items-center gap-1.5"
					aria-label="Print shopping list"
				>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z"/>
					</svg>
					Print
				</button>
			</div>
		</div>

		if len(d.Groups) == 0 {
			<!-- Empty state -->
			<div class="flex flex-col items-center justify-center py-24 text-center">
				<div class="w-16 h-16 rounded-full bg-surface-2 flex items-center justify-center mb-4">
					<svg class="h-8 w-8 text-ui-dim" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
					</svg>
				</div>
				<p class="text-ui-muted font-medium">No meals planned for this week</p>
				<p class="text-ui-dim text-sm mt-1">Add meals to your plan to generate a shopping list.</p>
				<a
					href={ templ.SafeURL(d.BasePath + "/plan?week=" + d.isoWeek()) }
					class="mt-4 px-4 py-2 bg-accent hover:bg-accent-hover text-white text-sm font-semibold rounded-lg transition-colors"
				>
					Go to plan
				</a>
			</div>
		} else {
			<!-- Summary bar -->
			<div class="flex items-center justify-between py-3 px-4 bg-surface-2 rounded-lg border border-ui-border-strong">
				<span class="text-sm text-ui-muted">
					<span id="shopping-total" class="text-ui-text font-semibold">{ fmt.Sprintf("%d", d.totalIngredients()) }</span> ingredients across <span class="text-ui-text font-semibold">{ fmt.Sprintf("%d", len(d.Groups)) }</span> meals
					<span id="shopping-progress" class="text-ui-dim"></span>
				</span>
				<button
					type="button"
					id="clear-checks-btn"
					class="no-print text-xs text-ui-muted hover:text-ui-subtext transition-colors"
				>
					Clear all checks
				</button>
			</div>

			<!-- Ingredient groups -->
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				for _, group := range d.Groups {
					<div class="bg-surface-2 border border-ui-border-strong rounded-xl p-4 space-y-3">
						<!-- Meal header -->
						<div class="flex items-start justify-between gap-2">
							<a
								href={ templ.SafeURL(d.BasePath + "/meals/" + group.Meal.ID) }
								class="font-semibold text-ui-text hover:text-accent transition-colors text-sm leading-snug"
							>
								{ group.Meal.Name }
								if group.Servings > 0 {
									<span class="text-ui-dim font-normal">{ fmt.Sprintf(" (%d servings)", group.Servings) }</span>
								}
							</a>
							if len(group.Slots) > 0 {
								<span class="shrink-0 text-xs text-ui-muted mt-0.5">{ group.Slots[0] }
									if len(group.Slots) > 1 {
										<span class="text-ui-dim"> +{ fmt.Sprintf("%d", len(group.Slots)-1) }</span>
									}
								</span>
							}
						</div>

						if len(group.Ingredients) == 0 {
							<p class="text-xs text-ui-dim italic">No ingredients listed</p>
						} else {
							<!-- Ingredient checklist -->
							<ul class="space-y-1.5">
								for _, ing := range group.Ingredients {
									<li class="flex items-center gap-2.5">
										<input
											type="checkbox"
											class="shopping-item h-4 w-4 shrink-0 rounded border-ui-border-medium bg-surface-3 text-accent focus:ring-accent focus:ring-offset-0 cursor-pointer"
											data-key={ itemKey(d.isoWeek(), group.Meal.ID, ing) }
										/>
										<span class="text-sm text-ui-subtext leading-snug">{ ing }</span>
									</li>
								}
							</ul>
						}
					</div>
				}
			</div>
		}

		<!-- Ad-hoc items -->
		<div class="bg-surface-2 border border-ui-border-strong rounded-xl p-4 space-y-3">
			<h2 class="font-semibold text-ui-text text-sm">Other items</h2>
			<form
				class="flex items-center gap-2 no-print"
				hx-post={ d.BasePath + "/shopping/extras" }
				hx-target="#extras-list"
				hx-swap="outerHTML"
				hx-on--after-request="if(event.detail.successful) this.reset()"
			>
				<input type="hidden" name="week" value={ d.isoWeek() }/>
				<input
					type="text"
					name="text"
					placeholder="Add item…"
					required
					class="flex-1 bg-surface-3 border border-ui-border rounded-lg px-3 py-2 text-sm text-ui-text placeholder-ui-dim focus:outline-none focus:ring-1 focus:ring-accent focus:border-accent"
				/>
				<button
					type="submit"
					class="px-3 py-2 bg-accent hover:bg-accent-hover text-white text-sm font-medium rounded-lg transition-colors"
				>
					Add
				</button>
			</form>
			@ExtrasList(d.isoWeek(), d.Extras, d.BasePath)
		</div>
	</div>

	<!-- localStorage persistence for checkboxes -->
	<script>
		(function() {
			const STORAGE_KEY = 'shopping-checked';

			function loadChecked() {
				try { return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]')); }
				catch { return new Set(); }
			}

			function saveChecked(set) {
				localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
			}

			function updateProgress() {
				const items = document.querySelectorAll('.shopping-item, .extra-item');
				const progress = document.getElementById('shopping-progress');
				const total = document.getElementById('shopping-total');
				if (total) total.textContent = String(items.length);
				if (!progress || items.length === 0) return;
				const checkedCount = Array.from(items).filter(function(cb) { return cb.checked; }).length;
				progress.textContent = ' · ' + checkedCount + ' of ' + items.length + ' checked';
			}

			// Extras (add/toggle/remove) all swap #extras-list via HTMX outerHTML,
			// which changes the total and checked count. htmx:afterSwap was found
			// not to fire reliably on this htmx build (see plan calendar remove-undo
			// work), so watch for the DOM change directly instead.
			const extrasList = document.getElementById('extras-list');
			if (extrasList && extrasList.parentElement) {
				new MutationObserver(updateProgress).observe(extrasList.parentElement, { childList: true, subtree: true, attributes: true });
			}

			// Restore checked state on load
			const checked = loadChecked();
			document.querySelectorAll('.shopping-item').forEach(function(cb) {
				if (checked.has(cb.dataset.key)) {
					cb.checked = true;
					cb.closest('li').querySelector('span').classList.add('line-through', 'text-ui-dim');
				}
				cb.addEventListener('change', function() {
					const set = loadChecked();
					if (cb.checked) {
						set.add(cb.dataset.key);
						cb.closest('li').querySelector('span').classList.add('line-through', 'text-ui-dim');
					} else {
						set.delete(cb.dataset.key);
						cb.closest('li').querySelector('span').classList.remove('line-through', 'text-ui-dim');
					}
					saveChecked(set);
					updateProgress();
				});
			});
			updateProgress();

			// Clear all checks
			const clearBtn = document.getElementById('clear-checks-btn');
			if (clearBtn) {
				clearBtn.addEventListener('click', function() {
					saveChecked(new Set());
					document.querySelectorAll('.shopping-item').forEach(function(cb) {
						cb.checked = false;
						cb.closest('li').querySelector('span').classList.remove('line-through', 'text-ui-dim');
					});
					document.querySelectorAll('.extra-item:checked').forEach(function(cb) {
						cb.click();
					});
					updateProgress();
				});
			}
		})();
	</script>
}

// ExtrasList renders the ad-hoc shopping items with add/toggle/remove parity
// with meal ingredients. It's also the HTMX response partial for add/toggle/remove.
templ ExtrasList(week string, extras []models.ShoppingExtra, basePath string) {
	<ul id="extras-list" class="space-y-1.5">
		if len(extras) == 0 {
			<li class="text-xs text-ui-dim italic">No extra items yet</li>
		} else {
			for _, extra := range extras {
				<li class="flex items-center gap-2.5 group">
					<input
						type="checkbox"
						class="extra-item h-4 w-4 shrink-0 rounded border-ui-border-medium bg-surface-3 text-accent focus:ring-accent focus:ring-offset-0 cursor-pointer"
						checked?={ extra.Checked }
						hx-post={ basePath + "/shopping/extras/" + extra.ID + "/toggle" }
						hx-vals={ fmt.Sprintf(`{"week":"%s","checked":"%t"}`, week, !extra.Checked) }
						hx-target="#extras-list"
						hx-swap="outerHTML"
					/>
					<span class={
						"text-sm leading-snug flex-1",
						templ.KV("text-ui-subtext", !extra.Checked),
						templ.KV("line-through text-ui-dim", extra.Checked),
					}>{ extra.Text }</span>
					<button
						type="button"
						class="no-print opacity-0 group-hover:opacity-100 text-ui-dim hover:text-red-400 transition-all"
						hx-delete={ basePath + "/shopping/extras/" + extra.ID + "?week=" + week }
						hx-target="#extras-list"
						hx-swap="outerHTML"
						aria-label="Remove item"
					>
						<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
						</svg>
					</button>
				</li>
			}
		}
	</ul>
}
